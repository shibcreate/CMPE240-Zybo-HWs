# Vivado generated/temp files
*.jou
*.log
*.str
*.wdb
*.wdf
*.pb
*.rpx
*.dll
*.so

# Vivado run outputs (regenerated by synthesis/implementation)
Zybo-Z7-10-DMA-hw/hw/hw.runs/
Zybo-Z7-10-DMA-hw/hw/hw.cache/
Zybo-Z7-10-DMA-hw/hw/hw.hw/
Zybo-Z7-10-DMA-hw/hw/.Xil/
Zybo-Z7-10-DMA-hw/hw/hw.ip_user_files/
Zybo-Z7-10-DMA-hw/hw/ip_upgrade.log

# Ignore bulky generated IP outputs in hw.gen (regenerated by "Generate Output Products")
Zybo-Z7-10-DMA-hw/hw/hw.gen/sources_1/bd/system/ip/
Zybo-Z7-10-DMA-hw/hw/hw.gen/sources_1/bd/system/ipshared/
Zybo-Z7-10-DMA-hw/hw/hw.gen/sources_1/bd/system/sim/
# Keep the HDL wrapper (small, needed to avoid re-creation after clone)
!Zybo-Z7-10-DMA-hw/hw/hw.gen/sources_1/bd/system/hdl/

# Vitis build outputs and BSP generated files
vitis_workspace/*/build/
vitis_workspace/system_wrapper/zynq_fsbl/
vitis_workspace/system_wrapper/export/
vitis_workspace/system_wrapper/ps7_cortexa9_0/standalone_ps7_cortexa9_0/bsp/libsrc/
vitis_workspace/system_wrapper/ps7_cortexa9_0/standalone_ps7_cortexa9_0/bsp/lib/
vitis_workspace/.analytics/
vitis_workspace/.metadata/
vitis_workspace/Zybo-Z7-10-Audio/build/
*.elf
*.o
*.d

# Ignore any user-created Vitis workspaces (each user creates their own)
my_vitis_workspace/
audio_ws/

# Extracted files (can be regenerated)
sw_extracted/

# Zip archives (too large for git)
*.zip

# Vivado library (too large, users should download separately)
vivado-library-master/

# Large binary files (regenerated by build)
*.bit
*.xsa

# Allow prebuilt binaries for direct programming
!prebuilt/*.bit
!prebuilt/*.xsa
!prebuilt/*.elf

# OS files
Thumbs.db
.DS_Store

# Claude Code local settings
.claude/
